<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cc.zorcc</groupId>
    <artifactId>tenet</artifactId>
    <version>0.0.4</version>
    <packaging>pom</packaging>
    <name>tenet project</name>
    <!-- currently not registered, might change in the future -->
    <url>https://cc.zorcc</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>tenet-core</module>
        <module>tenet-net</module>
        <module>tenet-serde</module>
        <module>tenet-serdeproc</module>
        <module>tenet-serde-testsuite</module>
        <module>tenet-log</module>
    </modules>
    <inceptionYear>2022</inceptionYear>

    <developers>
        <developer>
            <id>benrush</id>
            <email>benrush0705@gmail.com</email>
        </developer>
    </developers>

    <description>
        Tenet is a microservice toolkit for building high-performance network-based applications
    </description>

    <properties>
        <java.version>23</java.version>
        <resource.delimiter>@</resource.delimiter>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
        <junit.version>5.10.2</junit.version>
        <jmh.version>1.37</jmh.version>
        <jspecify.version>1.0.0</jspecify.version>
    </properties>

    <dependencies>
        <!-- junit  -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!--  jmh   -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <scope>test</scope>
        </dependency>

        <!--  jspecify   -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <scope>compile</scope>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!--  tenet projects  -->
            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-log</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-net</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-serde</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-serde-testsuite</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.zorcc</groupId>
                <artifactId>tenet-serdeproc</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- junit  -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!--  jmh   -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- jspecify -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>


        </dependencies>
    </dependencyManagement>


    <build>
        <pluginManagement>
            <plugins>
                <!-- compiler plugin enable preview features and vector API by default -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <encoding>${maven.compiler.encoding}</encoding>
                        <release>${java.version}</release>
                        <showDeprecation>true</showDeprecation>
                        <showWarnings>true</showWarnings>
                        <compilerArgs>
                            <arg>--enable-preview</arg>
                            <arg>--add-modules</arg>
                            <arg>jdk.incubator.vector</arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.openjdk.jmh</groupId>
                                <artifactId>jmh-generator-annprocess</artifactId>
                                <version>${jmh.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!--  tests are skipped by default   -->
                        <skipTests>true</skipTests>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>